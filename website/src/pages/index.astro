---
import { Code } from 'astro:components'
import { Image } from 'astro:assets'
import mark from '../assets/odicea-mark.svg'
import home from '../../../docs/assets/screenshots/home.png'
import rules from '../../../docs/assets/screenshots/rules.png'
import bandeja from '../../../docs/assets/screenshots/bandeja.png'
import { repository, base } from '../../scripts/docs.mjs'
import '../styles/landing.css'

// Internal links go through the deploy base (/odyssey/ on GitHub Pages).
const u = (path: string) => base + path

const clone = `git clone ${repository}.git && cd odyssey`
const setup = `${clone}
make dev       # secrets + fleet CA + .env → Postgres + IAMKit → seed (demo user)`
const run = `make run       # API on :8095
make worker    # outbox, workflows, scheduled tasks
make web       # console on http://localhost:5178

make smoke     # publish, auto-restore, "Volver a esta", audit`
const assistant = `# Claude Code
claude mcp add --transport http odicea http://localhost:8095/mcp

# Codex
codex mcp add odicea --url http://localhost:8095/mcp
codex mcp login odicea`
const prompt = `> Crea una app llamada Gastos y publica esta carpeta.
  Necesita una base de datos Postgres.

● create_app       Gastos · Interna
● create_database  postgres-basico → DATABASE_URL
● deploy_folder    construyendo… escaneando…
● IT's rule        "Publicar en producción" → pide aprobación
● En línea         https://gastos.apps.example.com`
const rule = `// Built-in rule · "Producción no publica con vulnerabilidades críticas"
action == 'deploy'
  && project.tier == 'production'
  && scan.known && scan.critical > 0     // → Bloquea (deny)`
const features = [
  { number: '01', title: 'Apps', text: 'Publish a folder, an image or a GitHub repo; every push publishes. Each app has its address, a version history and one-click “Volver a esta”.', tags: 'Folder · Image · GitHub', href: u('docs/guides/publish/') },
  { number: '02', title: 'Storage', text: 'Postgres, Redis, files and object storage from IT’s catalog, or resources the company already has. The app gets its connection as variables.', tags: 'Catalog · Recipes · Existing', href: u('docs/guides/storage/') },
  { number: '03', title: 'Who can open it', text: 'The team, the whole company, or anyone with the link. A sign-in sits in front of every app, with the company’s own accounts.', tags: 'Team · Organization · Public', href: u('docs/guides/who-can-open-it/') },
  { number: '04', title: 'IT’s rules', text: 'CEL rules allow, deny or hold any change for approval: publishing to production, going public, shipping critical vulnerabilities.', tags: 'CEL · Tiers · Built-ins', href: u('docs/guides/it/rules/') },
  { number: '05', title: 'Your clusters', text: 'Apps run on the company’s own Kubernetes. An agent dials out to the gateway over mTLS: no inbound port, no credentials in the control plane.', tags: 'Agent · Gateway · mTLS', href: u('docs/guides/it/clusters/') },
  { number: '06', title: 'AI for apps', text: 'An app gets its own key at the organization’s AI gateway, as the usual OPENAI_* and ANTHROPIC_* variables. Usual SDKs, no changes.', tags: 'OpenAI · Anthropic · Budget', href: u('docs/guides/ai-for-apps/') },
]
const flow = [
  { step: 'Ask', text: 'A person asks their assistant, uploads a folder or pushes to GitHub.' },
  { step: 'Check', text: 'IT’s rules allow it, deny it or hold it for an approver.' },
  { step: 'Build', text: 'The cluster’s agent builds the code and scans the image.' },
  { step: 'Serve', text: 'The app goes online behind the company sign-in.' },
  { step: 'Record', text: 'Every change lands in the audit log; a failed version restores itself.' },
]
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Odicea — Your people ship apps. IT keeps the keys.</title>
    <meta name="description" content="A governed platform for your company's internal apps: people publish with their coding assistant, IT sets the rules once, and apps run on the company's own clusters." />
    <meta property="og:title" content="Odicea — Your people ship apps. IT keeps the keys." />
    <meta property="og:description" content="Internal apps, without the shadow IT. Builders ship. IT decides. The company's clusters run it." />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Share the user's explicit choice with the documentation, before first paint.
      try {
        const saved = localStorage.getItem('starlight-theme');
        document.documentElement.dataset.theme = saved === 'light' || (!saved && matchMedia('(prefers-color-scheme: light)').matches) ? 'light' : 'dark';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <nav class="wrap navigation" aria-label="Main navigation">
        <a class="brand" href={u('')} aria-label="Odicea home"><img src={mark.src} width="28" height="28" alt="" />Odicea</a>
        <div class="nav-links"><a href="#what">What it is</a><a href="#it">For IT</a><a href="#start">Get started</a><a href={u('docs/')}>Documentation</a></div>
        <div class="nav-actions">
          <button id="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg></button>
          <a class="github-link" href={repository}>GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><span class="signal" aria-hidden="true"></span> Internal apps, without the shadow IT</p>
          <h1 id="hero-title">Your people ship apps.<br /><span>IT keeps the keys.</span></h1>
          <p class="hero-description">People build apps with their coding assistant, and Odicea publishes them on the company’s own clusters.<br class="desktop-break" /> IT sets the rules once — who may open what, what needs approval, which databases exist.</p>
          <div class="install-box" aria-label="Get the source">
            <div class="install-bar"><span class="mono">local stack · Go + Docker + Node</span><button class="copy" type="button" data-copy={setup}>Copy</button></div>
            <pre><code><span class="prompt">$</span> {clone}{'\n'}<span class="prompt">$</span> make dev</code></pre>
          </div>
          <div class="actions"><a class="button primary" href={u('docs/tutorials/first-app/')}>Your first app <span aria-hidden="true">→</span></a><a class="button secondary" href={u('docs/')}>Read the docs <span aria-hidden="true">↗</span></a></div>
          <p class="hero-note">Go control plane <span aria-hidden="true">/</span> One MCP <span aria-hidden="true">/</span> Your Kubernetes <span aria-hidden="true">/</span> IAMKit sign-in</p>
        </div>
      </section>

      <section class="showcase wrap" aria-label="The Odicea console">
        <figure class="browser">
          <div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">odicea.example.com</span></div>
          <Image src={home} widths={[960, 1440, 2160]} sizes="(max-width: 1160px) 100vw, 1160px" alt="The Odicea console's Inicio: what needs your attention, then the organization's apps with who can open them and their latest change." loading="eager" />
          <figcaption>The console’s Inicio. The interface is in Spanish; the documentation names every screen in English. Fictional data.</figcaption>
        </figure>
      </section>

      <div class="provider-strip"><div class="wrap provider-inner"><p>Assistants in, apps out.</p><ul aria-label="Supported assistants and platforms"><li>Claude Code</li><li>Codex</li><li>VS Code · Cursor</li><li>GitHub</li><li>Any Kubernetes</li></ul></div></div>

      <section id="what" class="section wrap" aria-labelledby="what-title">
        <div class="section-heading"><div><p class="eyebrow">What is Odicea</p><h2 id="what-title">Like Vercel,<br /><span>inside the company.</span></h2></div><p>Anyone who can describe an app to an assistant can publish it. Odicea builds it in the company’s cluster, scans it, checks IT’s rules, asks for an approval when one is needed and puts it online behind the company sign-in.</p></div>
        <div class="feature-grid">{features.map(feature => <article class="feature"><span class="feature-number">{feature.number} /</span><h3><a href={feature.href}>{feature.title}<span aria-hidden="true">↗</span></a></h3><p>{feature.text}</p><span class="feature-tags">{feature.tags}</span></article>)}</div>
        <ol class="flow" aria-label="The life of a version">{flow.map((item, i) => <li><span class="flow-number">{String(i + 1).padStart(2, '0')}</span><strong>{item.step}</strong><p>{item.text}</p></li>)}</ol>
        <p class="split-note"><strong>Builders ship.</strong> IT decides. <span>The company’s clusters run it.</span></p>
      </section>

      <section class="section wrap make-section" aria-labelledby="assistant-title">
        <div>
          <p class="eyebrow">One MCP for every assistant</p>
          <h2 id="assistant-title">Ask your assistant.<br /><span>Odicea does the rest.</span></h2>
          <p class="section-description">Odicea offers one MCP server with OAuth: the assistant opens the browser, the person signs in with the company account, and every call carries their permissions. IT’s rules apply to an assistant exactly as to a person.</p>
          <ul class="checks">
            <li><strong>Create, publish, go back.</strong> Apps, folders, images, repos, versions and rollbacks.</li>
            <li><strong>Storage on request.</strong> Databases and storage from IT’s catalog, connected as variables.</li>
            <li><strong>Secrets stay with people.</strong> An assistant asks a person to load a value; it never sees it.</li>
            <li><strong>A skill that knows the way.</strong> The <code>odicea</code> skill teaches the workflow, from preparing an app to diagnosing a failed version.</li>
          </ul>
          <div class="link-row"><a class="text-link" href={u('docs/guides/connect-an-assistant/')}>Connect your assistant →</a><a class="text-link" href={u('docs/reference/mcp-tools/')}>MCP tools →</a></div>
        </div>
        <div class="code-panel big"><div class="panel-bar"><span class="panel-label">Claude Code · Gastos</span><span class="panel-caption">MCP</span></div><Code code={prompt} lang="text" theme="css-variables" /></div>
      </section>

      <section id="it" class="section wrap delegate-section" aria-labelledby="rules-title">
        <figure class="browser small"><div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">Administración · Reglas</span></div><Image src={rules} widths={[720, 1080, 1440]} sizes="(max-width: 1000px) 100vw, 600px" alt="Administración → Reglas: writing a new rule in CEL and trying it on a sample action before saving it." /></figure>
        <div>
          <p class="eyebrow">For IT</p>
          <h2 id="rules-title">Set the rules once.<br /><span>Every app follows them.</span></h2>
          <p class="section-description">Rules written in CEL decide what is allowed, denied or held for approval, per app tier (sandbox, internal, production). Built-in rules cover the usual cases from day one; a rule that can’t be evaluated fails closed.</p>
          <pre class="tree" aria-label="An example rule">{rule}</pre>
          <div class="link-row"><a class="text-link" href={u('docs/guides/it/rules/')}>IT’s rules →</a><a class="text-link" href={u('docs/reference/rule-input/')}>What a rule can read →</a></div>
        </div>
      </section>

      <section class="section wrap make-section" aria-labelledby="approvals-title">
        <div>
          <p class="eyebrow">Approvals</p>
          <h2 id="approvals-title">Held, not refused.<br /><span>Decided in one place.</span></h2>
          <p class="section-description">When a rule asks for approval, the change waits in the approvers’ Bandeja with who asked, what and which rule held it. The requester never approves their own request, and an approval is used once.</p>
          <ul class="checks">
            <li><strong>Inventory.</strong> Every app and environment, who owns it, what it uses, exportable to CSV.</li>
            <li><strong>Audit log.</strong> Every change, hash-chained to the previous one.</li>
            <li><strong>Image scan.</strong> One Trivy job per build, in the cluster; rules can read the result.</li>
            <li><strong>Internet access.</strong> Per-cluster egress, enforced with NetworkPolicies.</li>
          </ul>
          <div class="link-row"><a class="text-link" href={u('docs/guides/it/approvals/')}>Approvals →</a><a class="text-link" href={u('docs/guides/it/inventory-and-audit/')}>Inventory and audit →</a></div>
        </div>
        <figure class="browser small"><div class="window-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="address">Bandeja · Inbox</span></div><Image src={bandeja} widths={[720, 1080, 1440]} sizes="(max-width: 1000px) 100vw, 600px" alt="The Bandeja: two requests held by IT's rules — a 40 GiB database and a production publish — with who asked, why and the buttons to approve or reject." /></figure>
      </section>

      <section id="start" class="install-section" aria-labelledby="start-title"><div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">Get started</p><h2 id="start-title">From clone<br />to first app.</h2></div><p>The local stack runs Postgres and IAMKit in Docker, and the API, the worker and the console on your machine. Apps go to an in-memory cluster first, so you can try everything without Kubernetes.</p></div>
        <ol class="steps-grid">
          <li class="step">
            <span class="step-number">01 / Set up</span>
            <h3>Clone and seed.</h3>
            <div class="code-panel"><button class="copy floating" type="button" data-copy={setup}>Copy</button><Code code={setup} lang="sh" theme="css-variables" /></div>
            <p class="step-foot">Needs Go, Docker, Node and an IAMKit checkout. The seed creates the demo user <code>ti@demo.local</code>. <a class="text-link" href={u('docs/guides/operations/local-development/')}>Run Odicea locally →</a></p>
          </li>
          <li class="step">
            <span class="step-number">02 / Run</span>
            <h3>Start the platform.</h3>
            <div class="code-panel"><Code code={run} lang="sh" theme="css-variables" /></div>
            <p class="step-foot">Sign in, create an app and upload a folder. <a class="text-link" href={u('docs/tutorials/first-app/')}>Your first app →</a></p>
          </li>
          <li class="step">
            <span class="step-number">03 / Connect</span>
            <h3>Bring your assistant.</h3>
            <div class="code-panel"><Code code={assistant} lang="sh" theme="css-variables" /></div>
            <p class="step-foot">The console shows these commands under “Conecta tu asistente”. <a class="text-link" href={u('docs/tutorials/first-app-with-an-assistant/')}>Publish with your assistant →</a></p>
          </li>
        </ol>
        <p class="warning"><strong>Real clusters:</strong> to build and serve for real, run the gateway and a local k3d cluster with the agent (<code>make cluster</code>, <code>make agent-enroll</code>, <code>make agent-image</code>). <a href={u('docs/tutorials/first-real-cluster/')}>Your first real cluster</a>.</p>
      </div></section>

      <section class="section wrap" aria-labelledby="planes-title">
        <div class="section-heading"><div><p class="eyebrow">How it runs</p><h2 id="planes-title">Four processes.<br />Two planes.</h2></div><p>The control plane never talks to Kubernetes. It sends the desired state through the gateway; the agent in each cluster applies it and reports back.</p></div>
        <div class="mode-grid">
          <a class="mode-card" href={u('docs/architecture/')}><span class="mono card-kicker">01 / API</span><h3>odyssey-api <span aria-hidden="true">↗</span></h3><p>The HTTP API, the MCP at /mcp and the sign-in for apps. Holds no cluster credentials.</p></a>
          <a class="mode-card" href={u('docs/explanation/life-of-a-version/')}><span class="mono card-kicker">02 / WORKER</span><h3>odyssey-worker <span aria-hidden="true">↗</span></h3><p>Outbox delivery, workflows (publish, build, approvals) and scheduled tasks.</p></a>
          <a class="mode-card" href={u('docs/explanation/security-model/')}><span class="mono card-kicker">03 / GATEWAY</span><h3>odyssey-gateway <span aria-hidden="true">↗</span></h3><p>Where agents enrol and keep their mTLS tunnel. The only holder of the fleet CA key.</p></a>
          <a class="mode-card" href={u('docs/guides/it/clusters/')}><span class="mono card-kicker">04 / AGENT</span><h3>odyssey-agent <span aria-hidden="true">↗</span></h3><p>In each cluster: dials out, builds, scans, serves apps and makes their storage.</p></a>
        </div>
      </section>

      <section class="section wrap status-section" aria-labelledby="status-title">
        <div><p class="eyebrow">Know what you’re adopting</p><h2 id="status-title">Early-stage software.<br /><span>Honest about it.</span></h2></div>
        <div class="status-grid">
          <article><span class="mono card-kicker">SOURCE</span><h3>Read the code.</h3><p>A Go control plane with a hexagonal layout whose rules are enforced by architecture tests, a Kubernetes agent and a React console.</p><a class="text-link" href={u('docs/architecture/')}>Architecture →</a></article>
          <article><span class="mono card-kicker">LIMITS</span><h3>Read the caveats.</h3><p>It works end to end on k3d and with real GitHub, but has not run a production pilot yet. APIs, CRDs and the schema may change.</p><a class="text-link" href={u('docs/project/known-limitations/')}>Known limitations →</a></article>
          <article><span class="mono card-kicker">TRUST</span><h3>Know the boundaries.</h3><p>Agents dial out over mTLS; secrets are sealed per cluster and never returned; rules fail closed; every change is audited.</p><a class="text-link" href={u('docs/explanation/security-model/')}>Security model →</a></article>
        </div>
      </section>

      <section class="section wrap faq-section" aria-labelledby="faq-title"><div><p class="eyebrow">A few useful answers</p><h2 id="faq-title">Before you start.</h2></div><div class="faq-list">
        <details><summary>Do I need Kubernetes to try it?</summary><p>No. By default the API and the worker publish to an in-memory cluster, so the console, the MCP and IT’s rules work without one. <a href={u('docs/tutorials/first-app/')}>Your first app</a> uses it.</p></details>
        <details><summary>Where do the apps run?</summary><p>On the company’s own Kubernetes clusters, on-premises or in any cloud. An agent in each cluster dials out to the gateway; the cluster needs no inbound port. <a href={u('docs/guides/it/clusters/')}>Connect a cluster</a>.</p></details>
        <details><summary>Which assistants can publish?</summary><p>Any assistant that speaks MCP over HTTP with OAuth: Claude Code, Codex, VS Code, Cursor and others. <a href={u('docs/guides/connect-an-assistant/')}>Connect your assistant</a>.</p></details>
        <details><summary>Who signs in to the apps?</summary><p>The company’s people, with their own accounts in IAMKit. IT chooses who may open each app: its team, the whole organization, or anyone with the link (held for approval by default). <a href={u('docs/guides/who-can-open-it/')}>Who can open an app</a>.</p></details>
        <details><summary>Can an assistant get around IT’s rules?</summary><p>No. Every MCP call runs as the person who signed in, with their permissions, through the same rules as the console. An assistant never sees a secret’s value. <a href={u('docs/explanation/security-model/')}>Security model</a>.</p></details>
      </div></section>

      <section class="closing wrap" aria-labelledby="closing-title"><p class="eyebrow">Builders ship. IT decides. The company’s clusters run it.</p><h2 id="closing-title">Your people ship apps.<br /><span>IT keeps the keys.</span></h2><div class="actions"><a class="button primary" href={u('docs/tutorials/first-app/')}>Your first app <span aria-hidden="true">→</span></a><a class="button secondary" href={u('docs/')}>Read the documentation <span aria-hidden="true">↗</span></a></div></section>
    </main>
    <footer class="footer"><div class="wrap footer-inner"><div><a class="brand" href={u('')}><img src={mark.src} width="22" height="22" alt="" />Odicea</a><p>A governed platform for your company’s internal apps.</p></div><nav aria-label="Footer navigation"><a href={u('docs/')}>Documentation</a><a href={u('docs/guides/operations/install/')}>Install</a><a href={u('docs/api/')}>API</a><a href={u('docs/project/known-limitations/')}>Known limitations</a><a href={u('docs/contributing/')}>Contributing</a><a href={repository}>GitHub</a></nav><span class="footer-note">Your people ship apps. IT keeps the keys.</span></div></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!
      function labelTheme() {
        toggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`)
      }
      labelTheme()
      toggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
        document.documentElement.dataset.theme = theme
        try { localStorage.setItem('starlight-theme', theme) } catch {}
        labelTheme()
      })

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '')
            button.textContent = 'Copied'
          } catch {
            button.textContent = 'Select & copy'
          }
          setTimeout(() => { button.textContent = 'Copy' }, 1600)
        })
      }
    </script>
  </body>
</html>
