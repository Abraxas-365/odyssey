# Copy to .env (make setup does it) and replace the secrets.
# Shared Postgres for the API + IAMKit (separate databases).
POSTGRES_PASSWORD=change-me
DB_PORT=5438

# IAMKit (users, sign-in, roles and permissions) — local dev instance, never prod.
IAMKIT_SRC=../../Desktop/Proyectos/iam
IAMKIT_PORT=8085
IAMKIT_ISSUER=http://localhost:8085
OIDC_HMAC_SECRET=change-me-to-32-random-bytes-or-more
IAMKIT_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5178

# ODYSSEY API
ODYSSEY_PORT=8095
# Browser origins allowed to call the API (comma-separated). Empty = CORS closed.
# CORS_ORIGINS=http://localhost:5178

# Where apps run: fake (in memory, default) or fleet (the organization's
# clusters, through their agents' tunnels to odyssey-gateway). The API and
# the worker must agree. `make run CLUSTER=fleet` / `make worker CLUSTER=fleet`.
# ODYSSEY_CLUSTER=fake
# Where uploaded sources and build logs live (API, worker and gateway share
# it): file://<dir>?create_dir=1&no_tmp_dir=1 locally, s3://bucket?region=…
# in production. `make run`/`make worker`/`make gateway` use .data/blobs.
# ODYSSEY_BLOB_URL=
# Who builds uploaded sources: fake (a scripted log and a placeholder
# image; the default with ODYSSEY_CLUSTER=fake), fleet (the environment's
# cluster, through its agent; the default with ODYSSEY_CLUSTER=fleet) or
# none (every build fails with NO_BUILDER). fake is refused with fleet (the
# placeholder images exist nowhere). The API and the worker must agree.
# ODYSSEY_BUILDER=
# The uploaded sources an organization keeps at once, in GiB compressed
# (default 10). When full, the oldest already built are dropped early.
# ODYSSEY_SOURCE_QUOTA_GIB=10
# The fleet: the CA (make setup creates it in secrets/fleet/; only the
# gateway gets its key) and the host:port agents dial. `make run` and
# `make gateway` set them for the local k3d cluster.
# FLEET_CA_CERT=
# FLEET_GATEWAY_URL=
# The compose gateway runs as the owner of secrets/fleet/ (the CA key stays
# 0600); make setup appends ODYSSEY_UID / ODYSSEY_GID.

# Demo user created by `make seed` (role TI of the demo organization).
DEMO_EMAIL=ti@demo.local
DEMO_PASSWORD=change-me-12-chars-min

# IAMKIT_AUDIENCE / IAMKIT_*_ID are appended by `make seed`, including
# IAMKIT_INTROSPECTION_CLIENT_ID/_SECRET (the API mounts /mcp only with them).
# The seed's resource audience is the MCP endpoint (http://localhost:$ODYSSEY_PORT/mcp,
# override with ODYSSEY_MCP_URL) and the assistants it admits come from
# MCP_PRESETS (default claude_code,codex,vscode,antigravity; empty = no MCP).
# MCP_PRESETS=claude_code,codex,vscode,antigravity

# Assistants the console offers under "Conecta tu asistente" (comma-separated,
# in this order): claude_code, codex, vscode, antigravity. Empty = the default.
# ODYSSEY_MCP_CLIENTS=claude_code,codex,vscode,antigravity
# The OAuth client IAMKit registered for Antigravity (appended by `make seed`
# when MCP_PRESETS includes it); lets deployments say "con Antigravity".
# IAMKIT_MCP_CLIENT_ANTIGRAVITY_ID=
